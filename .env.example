APP_NAME="Municipal Project Monitoring and Evaluation"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/muniparity%20of%20Naivasha%20ME/public
# Set a real sender address and configure PHP's outgoing mail transport for password resets.
MAIL_FROM=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=municipal_me
DB_USER=root
DB_PASSWORD=

# Generate at least 32 random bytes and set the output here before setup.
MUNI_SETUP_KEY=

# Private files and backups must stay outside the public web directory.
PRIVATE_STORAGE_PATH=storage/private
BACKUP_DIR=storage/backups
